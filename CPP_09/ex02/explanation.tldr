							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "8"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b3UazzCv",
			"typeName": "shape"
		},
		{
			"x": 6573.557841407994,
			"y": -34392.55715564114,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:j4zc1pkaLlPoGjnEMqiZZ",
			"type": "text",
			"props": {
				"color": "black",
				"size": "xl",
				"w": 4098.017110628782,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 4.246030942623289,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "For N sorted elements, there are N + 1 gaps."
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									},
									"marks": [
										{
											"type": "italic"
										}
									]
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "For our example of 8 elements, there are 9 gaps (_a1_a2...a8)."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "With 3 comparisons ("
								},
								{
									"type": "text",
									"text": "23=823=8"
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "), we can handle a maximum of 8 "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "gaps (which is a list size of 7). Since we have 9 gaps, 3 comparisons is not enough."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "With 4 comparisons ("
								},
								{
									"type": "text",
									"text": "24=1624=16"
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "), we can handle up to 16 gaps."
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									},
									"marks": [
										{
											"type": "italic"
										}
									]
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "This means 4 comparisons covers the range of 9 gaps to 16 gaps."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									},
									"marks": [
										{
											"type": "italic"
										}
									]
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "Translating gaps back to elements (Gaps - 1), this means the cost is 4 for any list size between 8 and 15 elements."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "The Jacobsthal sequence optimizes this by ensuring we fill the list to exactly 7 elements (8 gaps) to maximize the use "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "italic"
										}
									],
									"text": "of 3 comparisons before we are forced to jump to 4."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b0CNLI",
			"typeName": "shape"
		},
